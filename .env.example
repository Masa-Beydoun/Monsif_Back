# انسخي هالملف لـ .env وعبّي القيم:   cp .env.example .env
# .env مستثنى من git — ما بينرفع.

# ══════════════════ مفاتيح API ══════════════════
# النموذج اللغوي (الحكم الأولي + اقتراح نماذج العقود).
# hf   = HuggingFace Inference Providers — استدعاء API، بلا تنزيل أوزان ولا GPU.
# groq = Groq API.
LLM_BACKEND=hf

# مطلوب لـ LLM_BACKEND=hf. من https://huggingface.co/settings/tokens
# لازم يكون الحساب موافق على شروط مستودع النموذج (نماذج Meta Llama مقيّدة الوصول):
#   https://huggingface.co/meta-llama/Llama-3.1-8B-Instruct
HF_TOKEN=

# النماذج المجرّبة فعلياً على هذا المشروع:
#   meta-llama/Llama-3.3-70B-Instruct  ← الافتراضي. يجتاز التحقق كاملاً
#       (fully_grounded=true) ويختار المادة 656 الصحيحة، بحدود دقيقة وحدة.
#   meta-llama/Llama-3.1-8B-Instruct   ← أرخص لكنه لا يلتزم بصيغة الإخراج:
#       يقتبس المادة كاملة (58 كلمة بدل 12)، يكتب article_id ناقصاً، ويختار
#       657 خلافاً لكل السوابق المرفقة. صالح لتطوير الواجهة لا للنتائج.
#   ملاحظة: Llama-3.1-70B غير مخدوم على مزوّدي HuggingFace.
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct

# الواجهة الاحتياطية: تُستعمل تلقائياً لما تفشل الأساسية (نفاد حصة، تجاوز معدل،
# تعطّل المزوّد، مفتاح تالف). خليها فاضية إذا ما بدك احتياطي.
# من https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# ⚠️ مقيس من هالشبكة: api.groq.com بيرجع 403 «Access denied» قبل ما يقرأ المفتاح
# أصلاً — يعني حجب على مستوى الشبكة مش مشكلة مفتاح. الاحتياطي على groq ما رح
# يشتغل من هون. الواجهتان تحت وصلوا طبيعي وما ناقصهن غير مفتاح:
#   LLM_FALLBACK_BACKEND=openrouter   (فيه نماذج مجانية: أضيفي :free لاسم النموذج)
#   LLM_FALLBACK_BACKEND=gemini       (حصة مجانية سخية)
LLM_ENABLE_FALLBACK=true
LLM_FALLBACK_BACKEND=groq
LLM_FALLBACK_MODEL=qwen/qwen3.6-27b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
GEMINI_MODEL=gemini-2.0-flash

# مهلة الاستدعاء بالثواني، وعدد المحاولات عند 429/503 (حصة أو إقلاع النموذج).
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# اختياري: لتفكيك الاستعلامات الطويلة بـ RAG المواد (LAWS_DECOMPOSE=true)
GOOGLE_API_KEY=

# ══════════════════ الإقلاع ══════════════════
# أي ميزات تُحمّل نماذجها عند الإقلاع بدل أول طلب.
# فاضي = تحميل كسول (السيرفر بيقلع بثانية). مثال: WARMUP=laws,cases,contracts,search
WARMUP=
PORT=5000
DEBUG=true

# cpu | cuda | auto
DEVICE=auto

# ══════════════════ بارامترات RAG المواد القانونية ══════════════════
LAWS_TOP_N=7
LAWS_HYBRID_TOP_K=15
LAWS_EXCLUDE_REPEALED=false
LAWS_MIN_SCORE=0.0
LAWS_WITH_DEPENDENCIES=true
LAWS_DEP_DEPTH=2
LAWS_DEP_MAX=12
LAWS_DECOMPOSE=false
LAWS_RERANK_MAX_LENGTH=512

# ══════════════════ بارامترات RAG السوابق القضائية ══════════════════
CASES_TOP_K=5
CASES_HYBRID_TOP_K=15
CASES_THRESHOLD=0.50
CASES_RERANK_MAX_LENGTH=2048

# ══════════════════ بارامترات الحكم الأولي ══════════════════
JUDGMENT_TOP_K_LAWS=5
JUDGMENT_TOP_K_CASES=3
JUDGMENT_CASE_THRESHOLD=0.45
JUDGMENT_USE_CLASSIFIER=true
JUDGMENT_USE_FACT_REORG=true
JUDGMENT_USE_DISCRIMINATION=true
# ══════════════════ بارامترات RAG نماذج العقود ══════════════════
CONTRACTS_TOP_K=5
CONTRACTS_MIN_SCORE=0.0
# false = بحث دلالي صرف بدون أي استدعاء LLM
CONTRACTS_SUGGEST=true
# فاضي = نفس نموذج المشروع (BGE-M3). نموذج النوتبوك: intfloat/multilingual-e5-large
# ⚠️ أي تغيير بيلزمه: python scripts/build_contracts_index.py --force
# CONTRACTS_EMBEDDING_MODEL=
