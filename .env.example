# انسخي هالملف لـ .env وعبّي القيم:   cp .env.example .env
# .env مستثنى من git — ما بينرفع.

# ══════════════════ مفاتيح API ══════════════════
# مطلوب لميزة الحكم الأولي فقط. من https://console.groq.com/keys
GROQ_API_KEY=

# اختياري: لتفكيك الاستعلامات الطويلة بـ RAG المواد (LAWS_DECOMPOSE=true)
GOOGLE_API_KEY=

# ══════════════════ الإقلاع ══════════════════
# أي ميزات تُحمّل نماذجها عند الإقلاع بدل أول طلب.
# فاضي = تحميل كسول (السيرفر بيقلع بثانية). مثال: WARMUP=laws,cases,search
WARMUP=
PORT=5000
DEBUG=true

# cpu | cuda | auto
DEVICE=auto

# ══════════════════ بارامترات RAG المواد القانونية ══════════════════
LAWS_TOP_N=7
LAWS_HYBRID_TOP_K=15
LAWS_EXCLUDE_REPEALED=false
LAWS_MIN_SCORE=0.0
LAWS_WITH_DEPENDENCIES=true
LAWS_DEP_DEPTH=2
LAWS_DEP_MAX=12
LAWS_DECOMPOSE=false
LAWS_RERANK_MAX_LENGTH=512

# ══════════════════ بارامترات RAG السوابق القضائية ══════════════════
CASES_TOP_K=5
CASES_HYBRID_TOP_K=15
CASES_THRESHOLD=0.50
CASES_RERANK_MAX_LENGTH=2048

# ══════════════════ بارامترات الحكم الأولي ══════════════════
JUDGMENT_TOP_K_LAWS=5
JUDGMENT_TOP_K_CASES=3
JUDGMENT_CASE_THRESHOLD=0.45
JUDGMENT_USE_CLASSIFIER=true
JUDGMENT_USE_FACT_REORG=true
JUDGMENT_USE_DISCRIMINATION=true
GROQ_MODEL=qwen/qwen3.6-27b
